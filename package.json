{
  "name": "offer-star-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "dev:fixtures": "vite --host 127.0.0.1 --port 4173 --strictPort --config vite.test.config.ts",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox && node scripts/normalize-firefox-manifest.mjs",
    "test:firefox": "npm run build:firefox && node scripts/verify-firefox-lint.mjs",
    "test:firefox:runtime": "npm run build:firefox && node scripts/firefox-runtime-smoke.mjs",
    "test:firefox:page": "node scripts/firefox-page-smoke.mjs",
    "test:firefox:fixture": "npm run build:firefox && node scripts/firefox-fixture-smoke.mjs",
    "test:sites:reachability": "node scripts/site-reachability-smoke.mjs",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "test:manifests": "node scripts/verify-manifests.mjs",
    "test:contracts": "node scripts/verify-field-contract.mjs",
    "build:prototype": "tsc --noEmit && vite build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "verify:local": "npm run typecheck && npm test -- --run && npm run build:all && node scripts/verify-production-build.mjs && npm run test:manifests && npm run test:firefox && node scripts/verify-no-secrets.mjs",
    "verify": "npm run verify:local && npm run test:contracts",
    "test:security": "node scripts/verify-no-secrets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "node scripts/test-e2e-extension.mjs",
    "test:e2e:extension": "node scripts/test-e2e-extension.mjs",
    "test:e2e:ai": "node scripts/test-e2e-ai.mjs",
    "verify:full": "npm run verify && npm run test:e2e:extension && npm run test:e2e:ai && npm run test:firefox:runtime && npm run test:firefox:fixture"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.270",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  }
}
